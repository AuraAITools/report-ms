    <packaging>jar</packaging>
    <groupId>com.aura.keycloak-theme</groupId>
    <artifactId>keycloak-theme</artifactId>
    <description>
        Aura custom Keycloak email theme. Ship the resulting JAR into Keycloak's
        providers/ directory, then set the realm email-theme to "aura".
    </description>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>
</project>
