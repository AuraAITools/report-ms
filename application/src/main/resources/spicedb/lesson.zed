use import
use typechecking
import 'user.zed'
import 'course.zed'

definition lesson_user_group {
    // course_user_group's group-management cascades into this group,
    // which in turn cascades up the user_group chain to system_user_group
    relation parent: course_user_group

    // roles for the user group itself
    relation group_admin: user
    relation group_viewer: user

    // roles for the resource
    relation admin: user
    relation viewer: user
    relation modifier: user

    // Group-management permissions (act on the group resource itself)
    permission group_view: user = group_viewer + group_admin + parent->group_view
    permission group_add_viewer: user = group_admin + parent->group_add_viewer
    permission group_add_admin: user = group_admin + parent->group_add_admin
    permission group_remove_viewer: user = group_admin + parent->group_remove_viewer
    permission group_remove_admin: user = group_admin + parent->group_remove_admin
    permission group_add_modifier: user = group_admin + parent->group_add_modifier
    permission group_remove_modifier: user = group_admin + parent->group_remove_modifier
    permission group_add_group_admin: user = group_admin + parent->group_add_group_admin
    permission group_remove_group_admin: user = group_admin + parent->group_remove_group_admin
    permission group_add_group_viewer: user = group_admin + parent->group_add_group_viewer
    permission group_remove_group_viewer: user = group_admin + parent->group_remove_group_viewer

    // Resource-management permissions
    permission view: user = viewer + modifier + admin
    permission update: user = modifier + admin
    permission delete: user = admin
    permission is_admin_or_modifier: user = admin + modifier   // role-set helper for resource-level aliasing
}

definition lesson {
    relation parent: course
    relation user_group: lesson_user_group

    permission view: user = user_group->view + parent->view
    permission update: user = user_group->update + parent->update
    permission delete: user = user_group->delete + parent->delete
    permission is_admin_or_modifier: user = user_group->is_admin_or_modifier + parent->is_admin_or_modifier
    permission create_lesson_plan: user = is_admin_or_modifier
    permission create_lesson_objective: user = is_admin_or_modifier
}
