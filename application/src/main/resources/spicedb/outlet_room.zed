use import
use typechecking
import 'user.zed'
import 'outlet.zed'

// outlet_room is a child resource of outlet. It has no own user_group — all roles
// are inherited from the parent outlet (which itself inherits from institution and
// system). View / update / delete map 1:1 to the parent outlet's permissions.
definition outlet_room {
    relation parent: outlet

    permission view: user = parent->view
    permission update: user = parent->update
    permission delete: user = parent->delete
}
