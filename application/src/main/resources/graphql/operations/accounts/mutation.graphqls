extend type Mutation {
    createAccount(createAccountInput: CreateAccountInput!): AccountResponse!
    createParentInAccount(createParentInAccountInput: CreateParentInAccountInput!): ParentResponse!
    createStudentsInAccount(createStudentsInput: CreateStudentsInput!): [StudentResponse!]!
    createEducatorsInAccount(createEducatorsInput: CreateEducatorsInput!): [EducatorResponse!]!
    updateAccountFeatureState(updateAccountFeatureStateInput: UpdateAccountFeatureStateInput!): AccountResponse!
    createParentAndStudentsInAccount(createParentAndStudentsInAccountInput: CreateParentAndStudentsInAccountInput!): CreateParentAndStudentsInAccountResponse!
}
