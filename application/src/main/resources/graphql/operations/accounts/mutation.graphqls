extend type Mutation {
    createInstitutionAdminAccount(createAccountInput: CreateInstitutionAdminAccountInput): AccountResponse
    createParentAccount(createParentAccountInput: CreateParentAccountInput): AccountResponse
    createStudentsInParentAccount(createStudentInputs: [CreateStudentInput]): [StudentResponse]
    createEducatorsInAccount(createEducatorInputs: [CreateEducatorInput]): [EducatorResponse]
    addOutletAdmin(addOutletAdminInput: AddOutletAdminInput): Boolean
    addInstitutionAdmin(addInstitutionAdminInput: AddInstitutionAdminInput): Boolean
    addCourseAdmin(addCourseAdminInput: AddCourseAdminInput): Boolean
}
