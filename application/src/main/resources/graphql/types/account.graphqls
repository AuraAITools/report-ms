type AccountResponse implements Auditable @connection{
    id: ID!
    firstName: String!
    lastName: String!
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
    relationship: RELATIONSHIP
}

input CreateInstitutionAdminAccountInput {
    institutionId: ID!
    email: String!
    firstName: String!
    lastName: String!
    contact: Int!
}

input CreateParentAccountInput {
    institutionId: ID!
    email: String!
    firstName: String!
    lastName: String!
    contact: Int!
    relationship: RELATIONSHIP!
}

enum RELATIONSHIP {
    PARENT
    SELF
}

input AddOutletAdminInput {
    outletId: ID!
    userEmail: String!
}

input AddInstitutionAdminInput {
    institutionId: ID!
    userEmail: String!
}

input AddCourseAdminInput {
    courseId: ID!
    userEmail: String!
}
