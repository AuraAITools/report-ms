type AccountResponse implements Auditable {
    id: ID!
    firstName: String!
    lastName: String!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
    userId: ID!
    status: AccountStatus!
    parentFeatureState: AccountFeatureState!
    educatorFeatureState: AccountFeatureState!
    staffFeatureState: AccountFeatureState!
    """Presigned S3 GET URL for the account's profile image. Null if no image is set."""
    profileImageUrl: String
    students: [StudentResponse!]!
    parent: ParentResponse
    educators: [EducatorResponse!]!
}

enum AccountStatus {
    VERIFYING
    ACTIVE
    RETIRED
}

input CreateAccountInput {
    institutionId: ID!
    email: String!
    firstName: String!
    lastName: String!
    contact: Int!
}

input CreateParentInAccountInput {
    institutionId: ID!
    accountId: ID!
    relationship: RELATIONSHIP!
}

enum RELATIONSHIP {
    PARENT
    SELF
}

enum AccountFeature {
    PARENT_FEATURE
    EDUCATOR_FEATURE
    STAFF_FEATURE
}

enum AccountFeatureState {
    NOT_ONBOARDED
    ONBOARDING_IN_PROCESS
    ACTIVE
    INACTIVE
}

input UpdateAccountFeatureStateInput {
    institutionId: ID!
    accountId: ID!
    feature: AccountFeature!
    state: AccountFeatureState!
}

input CreateParentAndStudentsInAccountInput {
    institutionId: ID!
    accountId: ID!
    relationship: RELATIONSHIP!
    students: [AccountStudentDetailsInput!]! @ContainerSize(min: 1, message: "A minimum of 1 student is required")
}

input AccountStudentDetailsInput {
    name: String!
    email: String!
    dateOfBirth: Date!
    levelId: ID!
    schoolId: ID!
    courseEnrollments: [StudentCourseEnrollmentInput!]!
}

type CreateParentAndStudentsInAccountResponse {
    parent: ParentResponse!
    students: [StudentResponse!]!
}

"""
Response from requestAccountProfileImageUpload — the client uses uploadUrl to PUT
bytes directly to S3, then passes fileKey back to confirmAccountProfileImageUpload
to validate dimensions/size and persist the key on the account.
"""
type AccountProfileImageUploadResponse {
    uploadUrl: String!
    fileKey: String!
}

input RequestAccountProfileImageUploadInput {
    institutionId: ID!
    accountId: ID!
    """Must be one of: image/png, image/jpeg, image/webp."""
    contentType: String!
}

input ConfirmAccountProfileImageUploadInput {
    institutionId: ID!
    accountId: ID!
    """The fileKey returned from requestAccountProfileImageUpload, after the PUT completes."""
    fileKey: String!
}

