type AccountResponse implements Auditable {
    id: ID!
    firstName: String!
    lastName: String!
    createdAt: Long!
    createdBy: ID!
    updatedAt: Long
    updatedBy: ID
    userId: ID!
    status: AccountStatus!
    parentFeatureEnabled: Boolean!
    educatorFeatureEnabled: Boolean!
    staffFeatureEnabled: Boolean!
    students: [StudentResponse!]!
    parent: ParentResponse
    educators: [EducatorResponse!]!
}

enum AccountStatus {
    VERIFYING
    ACTIVE
    RETIRED
}

input CreateAccountInput {
    institutionId: ID!
    email: String!
    firstName: String!
    lastName: String!
    contact: Int!
}

input CreateParentInAccountInput {
    institutionId: ID!
    accountId: ID!
    relationship: RELATIONSHIP!
}

enum RELATIONSHIP {
    PARENT
    SELF
}

enum AccountFeature {
    PARENT_FEATURE
    EDUCATOR_FEATURE
    STAFF_FEATURE
}

input EnableAccountFeatureInput {
    institutionId: ID!
    accountId: ID!
    feature: AccountFeature!
}

input CreateParentAndStudentsInAccountInput {
    institutionId: ID!
    accountId: ID!
    relationship: RELATIONSHIP!
    students: [AccountStudentDetailsInput!]! @ContainerSize(min: 1, message: "A minimum of 1 student is required")
}

input AccountStudentDetailsInput {
    name: String!
    email: String!
    dateOfBirth: Date!
    levelId: ID!
    schoolId: ID!
    courseEnrollments: [StudentCourseEnrollmentInput!]!
}

type CreateParentAndStudentsInAccountResponse {
    parent: ParentResponse!
    students: [StudentResponse!]!
}

