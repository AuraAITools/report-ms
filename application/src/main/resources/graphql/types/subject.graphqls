input CreateSubjectInput {
    institutionId: ID!
    name: String!
}

type SubjectResponse implements Auditable {
    id: ID!
    name: String!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
    topics: [TopicResponse!]!
}

type SubjectResponseWithTopics {
    id: ID!
    name: String!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
    topics: [TopicResponse!]!
}

input CreateSubjectTopicLinksInput {
    institutionId: ID!
    id: ID!,
    topicIds: [ID!]! @Size(min: 1)
}
