type LessonGroupResponse implements Auditable {
    id: ID!
    name: String!
    lesson: LessonResponse!
    lessonGroupPlan: LessonGroupPlanResponse!
    lessonStudents: [LessonStudentResponse!]!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

"""
A student in a lesson group, paired with the student's lesson report for the
parent lesson. studentLessonReport is null until a report is created for the
student's StudentLessonLink.
"""
type LessonStudentResponse {
    student: StudentResponse!
    studentLessonReport: StudentLessonReportResponse
}

input CreateLessonGroupInLessonInput {
    institutionId: ID!
    lessonId: ID!
    name: String!
    studentIds: [ID!]!
    plan: CreateLessonGroupPlanForLessonGroupInput!
}

input CreateLessonGroupForLessonInput {
    name: String!
    studentIds: [ID!]!
    plan: CreateLessonGroupPlanForLessonGroupInput!
}
