type LessonResponse implements Auditable{
    id: ID!
    name: String!
    lessonStartTimestamptz: Long!
    lessonEndTimestamptz: Long!
    description: String
    state: LessonState!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
    outlet: OutletResponse!
    outletRoom: OutletRoomResponse
    course: CourseResponse!
    educators: [EducatorResponse!]!
    students: [StudentResponse!]!
    levels: [LevelResponse!]!
    subjects: [SubjectResponse!]!
    topics: [TopicResponse!]!
    lessonGroups: [LessonGroupResponse!]!
    materials: [MaterialResponse!]!
}

enum LessonState {
    CREATED
    ENDED
    CANCELLED
}

input CreateLessonInCourseInput {
    institutionId: ID!
    name: String!
    lessonStartTimestamptz: DateTime!
    lessonEndTimestamptz: DateTime!
    description: String
    courseId: ID!
    outletRoomId: ID
    educatorIds: [ID!]!
    studentIds: [ID!]!
    levelIds: [ID!]! @Size(min: 1, message: "lesson must have at least 1 level")
    subjectIds: [ID!]! @Size(min: 1, message: "lesson must have at least 1 subject")
    topicIds: [ID!]!
    lessonGroups: [CreateLessonGroupForLessonInput!]! @Size(min: 1, message: "lesson must have at least 1 lesson group")
}

input ChangeLessonOutletRoomInput {
    institutionId: ID!
    lessonId: ID!
    outletRoomId: ID
}

input AssignStudentsToLessonInput {
    institutionId: ID!
    lessonId: ID!
    studentIds: [ID!]!
}

input AssignEducatorsToLessonInput {
    institutionId: ID!
    lessonId: ID!
    educatorIds: [ID!]!
}

input GetLessonsInOutletByDateRangeInput {
    institutionId: ID!
    outletId: ID!
    startTimestamp: Long!
    endTimestamp: Long!
}
