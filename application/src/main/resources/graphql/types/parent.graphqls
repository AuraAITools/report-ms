type ParentResponse implements Auditable{
    id: ID!
    relationship: RELATIONSHIP!
    createdAt: Long!
    createdBy: ID!
    updatedAt: Long
    updatedBy: ID
}

input GetParentByIdInput {
    id: ID!
    institutionId: ID!
}

input UpdateParentByIdInput {
    id: ID!
    institutionId: ID!
    relationship: RELATIONSHIP
}

input DeleteParentByIdInput {
    id: ID!
    institutionId: ID!
}