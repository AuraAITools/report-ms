type UserPermissions {
    permissions: [ResourcePermissions!]!
}

type ResourcePermissions {
    resourceType: String!
    resourceId: String!
    permissions: [String!]!
}

type GroupResourcePermissions {
    resourceType: String!
    resourceId: String!
    displayName: String!
    permissions: [String!]!
}

type UserGroupRelations {
    resourceType: String!
    resourceId: String!
    displayName: String!
    relations: [String!]!
}

"""
Per-user_group-type buckets of the caller's relations within an institution.
Each subfield is resolved by its own @BatchMapping so it is loaded only when the
client selects it — useful when lessons/materials can be very large.
"""
type UserGroupRelationsInInstitution {
    institutionId: ID!
    institution: UserGroupRelations
    outlets: [UserGroupRelations!]!
    courses: [UserGroupRelations!]!
    lessons: [UserGroupRelations!]!
    materials: [UserGroupRelations!]!
    accounts: [UserGroupRelations!]!
}

type UserGroupMember {
    userId: ID!
    relations: [String!]!
    account: AccountResponse!
}

enum UserGroupType {
    SYSTEM_USER_GROUP
    INSTITUTION_USER_GROUP
    OUTLET_USER_GROUP
    COURSE_USER_GROUP
    LESSON_USER_GROUP
    ACCOUNT_USER_GROUP
}

enum UserGroupRole {
    ADMIN
    MODIFIER
    VIEWER
    GROUP_ADMIN
    GROUP_VIEWER
}

input GrantUserGroupRoleInput {
    institutionId: ID!
    userGroupType: UserGroupType!
    userGroupId: ID!
    role: UserGroupRole!
    userId: ID!
}

input RevokeUserGroupRoleInput {
    institutionId: ID!
    userGroupType: UserGroupType!
    userGroupId: ID!
    role: UserGroupRole!
    userId: ID!
}
