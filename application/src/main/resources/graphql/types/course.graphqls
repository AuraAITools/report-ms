input CreateCourseInput {
    institutionId: ID!
    lessonFrequency: LessonFrequency!
    priceRecord: CreatePriceRecordInput!
    name: String!
    maxSize: Int!
    courseStartTimestamptz: DateTime!
    courseEndTimestamptz: DateTime!
    outletId:ID!
    subjectIds: [ID!]!
    educatorIds: [ID!]!
    studentIds: [ID!]!
    levelId: ID
}

input CreatePriceRecordInput {
    price: Float!
    frequency: PriceFrequency!
}

type CourseResponse implements Auditable{
    id: ID!
    lessonFrequency: LessonFrequency!
    priceRecord: PriceRecordResponse
    name: String!
    maxSize: Int!
    courseStartTimestamptz: Long!
    courseEndTimestamptz: Long!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
    lessons: [LessonResponse!]!
    educators: [EducatorResponse!]!
    students: [StudentResponse!]!
    level: LevelResponse
    subjects: [SubjectResponse!]!
}

enum LessonFrequency {
    WEEKLY
    FORTNIGHTLY
    MONTHLY
}

type PriceRecordResponse {
    id: ID!
    price: Float!
    frequency: PriceFrequency!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

enum PriceFrequency {
    MONTHLY
    WEEKLY
    PER_LESSON
    TOTAL
}
