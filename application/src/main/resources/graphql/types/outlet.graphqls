type OutletResponse implements Auditable @connection{
    id: ID!
    name: String!
    address: String!
    postalCode: Int!
    contactNumber: Int!
    description: String!
    email: String!
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
}

input CreateOutletInput {
    institutionId: ID!
    name: String!
    address: String!
    postalCode: Int!
    contactNumber: Int!
    description: String!
    email: String!
}

input OutletSearchInput {
    name: String
    address: String
    postalCode: String
    contactNumber: String
    description: String
    email: String
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
}
