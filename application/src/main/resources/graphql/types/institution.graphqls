type InstitutionResponse implements Auditable{
    id: ID!
    name: String!
    email: String!
    contactNumber: String!
    address: String!
    uen: String!
    logoUrl: String
    """Presigned S3 GET URL for the institution's profile image. Null if no image is set."""
    profileImageUrl: String
    state: InstitutionState!
    outlets: [OutletResponse!]!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

enum InstitutionState {
    PENDING
    ACTIVE
    INACTIVE
}

interface Auditable {
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

input CreateInstitutionInput {
    name: String! @Size(min: 1, max: 20, message: "name must be at least 1 character with maximum of 20 characters")
    email: String!
    contactNumber: String!
    address: String!
    uen: String!
}

input InstitutionSearchInput {
    name: String
    email: String
    contactNumber: String
    address: String
    uen: String
    createdAt: Long
    updatedAt: Long
}

input SortInput {
    field: String!
    direction: SortDirection!
}

enum SortDirection {
    ASCENDING
    DESCENDING
}

"""
Response from requestInstitutionProfileImageUpload — the client uses uploadUrl to PUT
bytes directly to S3, then passes fileKey back to confirmInstitutionProfileImageUpload
to validate dimensions/size and persist the key on the institution.
"""
type InstitutionProfileImageUploadResponse {
    uploadUrl: String!
    fileKey: String!
}

input RequestInstitutionProfileImageUploadInput {
    institutionId: ID!
    """Must be one of: image/png, image/jpeg, image/webp."""
    contentType: String!
}

input ConfirmInstitutionProfileImageUploadInput {
    institutionId: ID!
    """The fileKey returned from requestInstitutionProfileImageUpload, after the PUT completes."""
    fileKey: String!
}
