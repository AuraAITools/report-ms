type SchoolResponse implements Auditable {
    id: ID!
    name: String!
    schoolCategory: SchoolCategory!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

enum SchoolCategory {
    PRIMARY
    SECONDARY
    JUNIOR_COLLEGE
    POLYTECHNIC
    TECHNICAL
    INTERNATIONAL
    ARTS
    UNIVERSITY
}

input CreateSchoolInput {
    institutionId: ID!
    name: String!
    schoolCategory: SchoolCategory!
}

input DeleteSchoolInInstitutionInput {
    institutionId: ID!
    schoolId: ID!
}
