type LevelResponse implements Auditable {
    id: ID!
    name: String!
    category: SCHOOL_CATEGORY!
    createdAt: Long!
    createdBy: ID!
    updatedAt: Long
    updatedBy: ID
}

input LevelSearchInput {
    name: String
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
}

input CreateLevelInInstitutionInput {
    institutionId: ID!
    name: String!
    category: SCHOOL_CATEGORY!
}

enum SCHOOL_CATEGORY {
    PRIMARY
    SECONDARY
    JUNIOR_COLLEGE
    POLYTECHNIC
    TECHNICAL
    INTERNATIONAL
    ARTS
    UNIVERSITY
}
