type LessonPlanResponse implements Auditable {
    id: ID!
    plan: String!
    recap: String!
    state: LessonPlanState!
    lesson: LessonResponse!
    topics: [TopicResponse!]!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

enum LessonPlanState {
    UNPLANNED
    DRAFT
    PLANNED
}

input CreateLessonPlanInLessonInput {
    institutionId: ID!
    lessonId: ID!
    plan: String!
    topicIds: [ID!]!
    studentIds: [ID!]!
    materialIds: [ID!]!
    lessonObjectives: [CreateLessonObjectiveInLessonPlanInput!]!
}

input CreateLessonPlanForLessonInput {
    plan: String!
    topicIds: [ID!]!
    studentIds: [ID!]!
    materialIds: [ID!]!
    lessonObjectives: [CreateLessonObjectiveInLessonPlanInput!]!
}

input CreateLessonObjectiveInLessonPlanInput {
    name: String!
    objective: String!
    topicIds: [ID!]!
}
