type LessonHomeworkCompletionResponse implements Auditable {
    id: ID!
    studentLessonReportId: ID!
    completion: Int
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

input CreateLessonHomeworkCompletionInput {
    institutionId: ID!
    lessonId: ID!
    studentLessonReportId: ID!
    completion: Int
}

input UpdateLessonHomeworkCompletionInput {
    institutionId: ID!
    lessonId: ID!
    id: ID!
    completion: Int!
}

input DeleteLessonHomeworkCompletionInput {
    institutionId: ID!
    lessonId: ID!
    id: ID!
}
