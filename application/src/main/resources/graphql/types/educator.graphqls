type EducatorResponse implements Auditable{
    id: ID!
    name: String!
    startDate: Date!
    dateOfBirth: Date!
    email: String!
    employmentType: EmploymentType!
    courses: [CourseResponse!]!
    subjects: [SubjectResponse!]!
    outlets: [OutletResponse!]!
    levels: [LevelResponse!]!
    account: AccountResponse!
    """Presigned S3 GET URL for the educator's profile image. Null if no image is set."""
    profileImageUrl: String
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}
input CreateEducatorsInput {
    institutionId: ID!
    educators: [CreateEducatorInput!]!
}
input CreateEducatorInput {
    name: String!
    startDate: Date!
    dateOfBirth: Date!
    email: String!
    employmentType: EmploymentType!
    courseIds: [ID!]!
    subjectIds: [ID!]!
    outletIds: [ID!]!
    levelIds: [ID!]!
    accountId: ID!
    institutionId: ID!
}

enum EmploymentType {
    FULL_TIME
    PART_TIME
}

input GetEducatorByIdInput {
    id: ID!
    institutionId: ID!
}

input UpdateEducatorByIdInput {
    id: ID!
    institutionId: ID!
    name: String
    startDate: Date
    dateOfBirth: Date
    email: String
    employmentType: EmploymentType
}

input DeleteEducatorByIdInput {
    id: ID!
    institutionId: ID!
}

"""
Response from requestEducatorProfileImageUpload — the client uses uploadUrl to PUT bytes
directly to S3, then passes fileKey back to confirmEducatorProfileImageUpload to
validate dimensions/size and persist the key on the educator.
"""
type EducatorProfileImageUploadResponse {
    uploadUrl: String!
    fileKey: String!
}

input RequestEducatorProfileImageUploadInput {
    institutionId: ID!
    educatorId: ID!
    """Must be one of: image/png, image/jpeg, image/webp."""
    contentType: String!
}

input ConfirmEducatorProfileImageUploadInput {
    institutionId: ID!
    educatorId: ID!
    """The fileKey returned from requestEducatorProfileImageUpload, after the PUT completes."""
    fileKey: String!
}
