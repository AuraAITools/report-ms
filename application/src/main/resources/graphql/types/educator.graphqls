type EducatorResponse implements Auditable{
    id: ID!
    name: String!
    startDate: Date!
    dateOfBirth: Date
    email: String!
    employmentType: EmploymentType!
    courses: [CourseResponse!]!
    subjects: [SubjectResponse!]!
    outlets: [OutletResponse!]!
    levels: [LevelResponse!]!
    account: AccountResponse!
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
}

input CreateEducatorInput {
    name: String!
    startDate: Date!
    dateOfBirth: Date
    email: String!
    employmentType: EmploymentType!
    courseIds: [ID!]!
    subjectIds: [ID!]!
    outletIds: [ID!]!
    levelIds: [ID!]!
    accountId: ID!
}

enum EmploymentType {
    FULL_TIME
    PART_TIME
}
