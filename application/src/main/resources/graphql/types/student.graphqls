type StudentResponse implements Auditable{
    id: ID!
    name: String!
    email: String!
    dateOfBirth: Date!
    level: LevelResponse!
    school: SchoolResponse!
    courses: [CourseResponse!]!
    """Presigned S3 GET URL for the student's profile image. Null if no image is set."""
    profileImageUrl: String
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

"""
Response from requestStudentProfileImageUpload — the client uses uploadUrl to PUT bytes
directly to S3, then passes fileKey back to confirmStudentProfileImageUpload to
validate dimensions/size and persist the key on the student.
"""
type StudentProfileImageUploadResponse {
    uploadUrl: String!
    fileKey: String!
}

input RequestStudentProfileImageUploadInput {
    institutionId: ID!
    studentId: ID!
    """Must be one of: image/png, image/jpeg, image/webp."""
    contentType: String!
}

input ConfirmStudentProfileImageUploadInput {
    institutionId: ID!
    studentId: ID!
    """The fileKey returned from requestStudentProfileImageUpload, after the PUT completes."""
    fileKey: String!
}
input CreateStudentsInput {
    institutionId: ID!
    students: [CreateStudentInput!]!
}
input CreateStudentInput {
    accountId: ID!
    name: String!
    email: String!
    dateOfBirth: Date!
    levelId: ID!
    schoolId: ID!
    institutionId: ID!
    courseEnrollments: [StudentCourseEnrollmentInput!]!
}

input StudentCourseEnrollmentInput {
    courseId: ID!
    startDate: Date!
}

input GetStudentByIdInput {
    id: ID!
    institutionId: ID!
}

input UpdateStudentByIdInput {
    id: ID!
    institutionId: ID!
    name: String
    email: String
    dateOfBirth: Date
}

input DeleteStudentByIdInput {
    id: ID!
    institutionId: ID!
}
