type LessonQuizResponse implements Auditable {
    id: ID!
    lessonGroupPlanId: ID!
    name: String!
    score: Int!
    maxScore: Int!
    createdAt: Long!
    createdBy: AccountMinimalDetail!
    updatedAt: Long
    updatedBy: AccountMinimalDetail
}

input CreateLessonQuizInput {
    institutionId: ID!
    lessonId: ID!
    lessonGroupPlanId: ID!
    name: String!
    score: Int!
    maxScore: Int!
}

input UpdateLessonQuizInput {
    id: ID!
    institutionId: ID!
    lessonId: ID!
    name: String
    score: Int!
    maxScore: Int!
}

input DeleteLessonQuizByIdInput {
    id: ID!
    institutionId: ID!
    lessonId: ID!
}
