type AccountResponse implements Auditable @connection{
    id: ID!
    firstName: String!
    lastName: String!
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
    relationship: RELATIONSHIP
}

input CreateInstitutionAdminAccountInput {
    email: String!
    firstName: String!
    lastName: String!
    contact: Int!
}

input CreateParentAccountInput {
    email: String!
    firstName: String!
    lastName: String!
    contact: Int!
    relationship: RELATIONSHIP!
}

enum RELATIONSHIP {
    PARENT
    SELF
}

input AddUserToGroupInput {
    userEmail: String!
    groupName: String!
}