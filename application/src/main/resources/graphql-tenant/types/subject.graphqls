input CreateSubjectInput {
    name: String!
}

type SubjectResponse implements Auditable @connection{
    id: ID!
    name: String!
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
}

type SubjectResponseWithTopics {
    id: ID!
    name: String!
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
    topics: [TopicResponse!]!
}

input CreateSubjectTopicLinksInput {
    id: ID!,
    topicIds: [ID!]! @Size(min: 1)
}