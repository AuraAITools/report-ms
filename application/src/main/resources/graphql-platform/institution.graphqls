type InstitutionResponse {
    id: ID!
    name: String!
    email: String!
    contactNumber: String!
    address: String!
    uen: String!
    createdAt: Long
    createdBy: ID
    updatedAt: Long
    updatedBy: ID
}

input CreateInstitutionInput {
    name: String!
    email: String!
    contactNumber: String!
    address: String!
    uen: String!
}
